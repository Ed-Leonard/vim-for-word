{
  "manifest_version": 3,
  "name": "Vim for Word Online",
  "version": "0.1.0",
  "description": "Vim motions for Word for the web",
  "content_scripts": [
    {
      "matches": [
        "https://*.officeapps.live.com/*",
        "https://*.office.com/*",
        "https://onedrive.live.com/*",
        "https://*.sharepoint.com/*"
      ],
      "js": [
        "src/mode-state.js",
        "src/selection-utils.js",
        "src/motions.js",
        "src/styles.js",
        "src/render.js",
        "src/content-script.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "vim-for-word@edleonard.dev",
      "strict_min_version": "109.0"
    }
  }
}
