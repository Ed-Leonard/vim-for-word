{
  "manifest_version": 3,
  "name": "Vim for Word Online",
  "version": "0.1.0",
  "description": "Vim motions for Word for the web",
  "permissions": ["nativeMessaging"],
  "browser_specific_settings": {
    "gecko": { "id": "vim-for-word@typo" }
  },
  "background": { "scripts": ["src/background.js"] },
  "content_scripts": [
    {
      "matches": [
        "https://*.officeapps.live.com/*",
        "https://*.office.com/*",
        "https://onedrive.live.com/*",
        "https://*.sharepoint.com/*"
      ],
      "js": [
        "src/vimmode.js",
        "src/render.js",
        "src/keys.js",
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
